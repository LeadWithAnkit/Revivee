# REVIVE Environment Configuration Example
# ==========================================

# 1. Vercel Serverless Function Database Secret (Set in Vercel Dashboard -> Environment Variables)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.e0usepo.mongodb.net/?appName=Cluster0

# 2. Client-Side Data Mode Configuration
# Options:
#  - "auto" (default): Checks Vercel API / Serverless health, connects to MongoDB if available, otherwise falls back to IndexedDB local storage
#  - "local": Force client-only IndexedDB local storage mode
VITE_DATA_MODE=auto
